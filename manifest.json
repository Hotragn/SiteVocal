{
  "manifest_version": 3,
  "name": "SiteVocal — Website to Speech Reader",
  "short_name": "SiteVocal",
  "version": "2.8.0",
  "description": "Hear any web page: a short summary of its key points, a 60-second site briefing, or every word ad-free. No API keys.",
  "homepage_url": "https://github.com/Hotragn/sitevocal",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Read this page with SiteVocal (Alt+Shift+S)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "side_panel": {
    "default_path": "panel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["activeTab", "contextMenus", "scripting", "sidePanel", "storage"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "commands": {
    "read-page": {
      "suggested_key": { "default": "Alt+Shift+S" },
      "description": "Read the current page with SiteVocal"
    }
  },
  "sandbox": {
    "pages": ["index.html"]
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'",
    "sandbox": "sandbox allow-scripts allow-forms allow-popups allow-popups-to-escape-sandbox allow-modals; script-src 'self'; object-src 'none'; child-src 'self'"
  }
}
